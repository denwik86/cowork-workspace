# =============================================================================
#  VERTICAL STUDIO — Environment Variables
#  Copy this file to .env, fill in real values, NEVER commit .env to git.
#  Mount this into the agent-api container via docker-compose.
# =============================================================================

# --- Core ---
NODE_ENV=production
STUDIO_ROOT=/opt/studio
TIMEZONE=Europe/Amsterdam
OWNER_NAME=Viktar
OWNER_EMAIL=denwik86@gmail.com

# --- Anthropic (Claude Sonnet 4.6 + Haiku 4.5) ---
ANTHROPIC_API_KEY=
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-6
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_PROMPT_CACHE=true

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_MAYA=                # S1 — Charlotte recommended
ELEVENLABS_VOICE_FUTURE_MAYA=         # S1 — Bella (lower, distorted)
ELEVENLABS_VOICE_ELLA=                # S2 — Bella
ELEVENLABS_VOICE_KIRI=                # S3 — Daniel (NL-accent EN)
ELEVENLABS_VOICE_NARRATOR_S4=         # S4 — Charlotte (whisper register)

# --- Sora (no public API; Playwright drives the web app) ---
SORA_EMAIL=
SORA_PASSWORD=
SORA_SESSION_COOKIE=                  # optional shortcut; otherwise Playwright logs in
SORA_HEADLESS=true
SORA_DAILY_CLIP_BUDGET=12              # max clips per day across all series

# --- Google Sheets (service account JSON) ---
GOOGLE_SERVICE_ACCOUNT_JSON=/opt/studio/secrets/gsheets.json
KPI_SHEET_ID=                          # the long ID in the spreadsheet URL

# --- YouTube Data API v3 (OAuth) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=                 # generate with scripts/oauth_youtube.js
YOUTUBE_CHANNEL_ID=

# --- Instagram Graph API ---
META_APP_ID=
META_APP_SECRET=
IG_USER_ID=                            # business/creator account
IG_LONG_LIVED_TOKEN=

# --- TikTok Content Posting API (apply Day 1; takes 1–3 weeks) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=
# Until TikTok approves you, set TIKTOK_FALLBACK=manual to queue posts for manual upload.
TIKTOK_FALLBACK=manual

# --- Replicate (optional, Flux Schnell for thumbnails / B-roll stills) ---
REPLICATE_API_TOKEN=

# --- Epidemic Sound (optional) ---
EPIDEMIC_PERSONAL_LICENSE_EMAIL=

# --- Slack (preferred for approval bot) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APPROVAL_CHANNEL=#studio-approvals

# --- Telegram (fallback approval bot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Guard rails (sane defaults; tighten in config/guardrails.json) ---
GUARD_WEEKLY_BUDGET_USD=40
GUARD_MONTHLY_BUDGET_USD=150
GUARD_SONNET_WEEKLY_TOKENS=100000
GUARD_ELEVENLABS_WEEKLY_CHARS=30000
GUARD_SORA_WEEKLY_CLIPS=60
GUARD_BOOST_MAX_USD=50

# --- Agent API ---
AGENT_API_PORT=4000
AGENT_API_SHARED_SECRET=               # random 48-char string; n8n uses this as Bearer

# --- n8n ---
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=               # set a long random one
N8N_ENCRYPTION_KEY=                    # 32+ random chars, NEVER lose this
N8N_HOST=                              # e.g. studio.yourdomain.com (or droplet IP)
WEBHOOK_URL=                           # https://studio.yourdomain.com/
