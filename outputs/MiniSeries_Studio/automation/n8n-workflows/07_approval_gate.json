{
  "name": "07 — Approval Gate (Monday weekly budget)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "cronExpression", "expression": "0 9 * * 1" }] }
      },
      "id": "cron-7",
      "name": "Mon 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "={{$env.AGENT_API_URL || 'http://agent-api:4000'}}/guardrails/check",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{$env.AGENT_API_SHARED_SECRET}}" }
          ]
        },
        "sendBody": true,
        "jsonBody": "={}"
      },
      "id": "call-7",
      "name": "Check guardrails",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [520, 300]
    },
    {
      "parameters": {
        "channel": "={{$env.SLACK_APPROVAL_CHANNEL}}",
        "text": "=*Weekly production plan*\nCap: ${{$json.caps.weeklyBudgetUsd}} | Used this week: ${{$json.head.weekUsed?.toFixed(2) || 0}}\nPredicted next 7 days: ~$5.04 (8 episodes)\nReply *approve* / *cap N* / *skip*.",
        "authentication": "accessToken"
      },
      "id": "slack-7",
      "name": "Ask owner",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [800, 300]
    }
  ],
  "connections": {
    "Mon 09:00": { "main": [[{ "node": "Check guardrails", "type": "main", "index": 0 }]] },
    "Check guardrails": { "main": [[{ "node": "Ask owner", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": ["studio", "agent"]
}
